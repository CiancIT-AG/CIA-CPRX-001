managed with additional save implementation in class zcprx_bp_r_product unique;
strict ( 2 );

define behavior for ZCPRX_R_Product alias Product
persistent table zcprxart
lock master
authorization master ( global )
etag master LocalLastChangedAt
{
  field ( readonly : update, mandatory : create ) Product;
  field ( readonly ) ProductDescription, ProductGroup, ProductType,
                     PraxedoId, Status, LastSentAt, MessageText,
                     CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  create;          // nur technisch (Tagesjob)
  update;
  delete;

  action sendToPraxedo result [1] $self;
  action setSyncResult parameter ZCPRX_A_SyncResult result [1] $self;

  mapping for zcprxart
  {
    Product            = product;
    PraxedoId          = praxedo_id;
    Status             = status;
    LastSentAt         = last_sent_at;
    MessageText        = message_text;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}